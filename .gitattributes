# Keep source and documentation consistent across contributor platforms.
* text=auto eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf

# Generated media must not receive text normalization or misleading text diffs.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
*.zip binary
