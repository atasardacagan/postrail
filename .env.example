# Run npm run env:init to generate local secrets; then fill your provider credentials.
NODE_ENV=production
APP_MODE=live
HOST=0.0.0.0
PORT=3000
POSTGRES_PASSWORD=GENERATE_DB_PASSWORD
# env:init uses the same generated password here. Compose changes the host to postgres.
DATABASE_URL=postgresql://brand:YOUR_DATABASE_PASSWORD@127.0.0.1:5432/brand_engine
ADMIN_API_TOKEN=GENERATE_ADMIN_TOKEN
TELEGRAM_WEBHOOK_SECRET=GENERATE_WEBHOOK_SECRET
# Obtain your own numeric user ID via a private /start update (README).
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_BOT_TOKEN=
# polling needs no public inbound URL. webhook requires public HTTPS endpoint.
TELEGRAM_MODE=polling
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://YOUR_DOMAIN/oauth/linkedin/callback
# Optional manual token route: use token + author URN instead of OAuth credentials.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
# Verified documentation version; review official supported versions before deployment.
LINKEDIN_API_VERSION=202605
# Enable only after Community Management API / r_member_postAnalytics approval + reauthorization.
LINKEDIN_ANALYTICS_ENABLED=false
# 32 bytes represented as 64 HEX characters. Keep stable and back it up separately.
TOKEN_ENCRYPTION_KEY=GENERATE_ENCRYPTION_KEY
WORKER_INTERVAL_MS=5000
LOG_LEVEL=info
