{
  "name": "postrail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "worker": "node --import tsx src/worker.ts",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "dev:offline": "node --import tsx scripts/offline.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:postgres": "node --import tsx scripts/test-postgres.ts",
    "audit:source": "node scripts/audit-source.mjs",
    "build": "tsc",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "env:init": "node --import tsx scripts/init-env.ts",
    "telegram:configure": "node --import tsx scripts/configure-telegram.ts",
    "doctor": "node --import tsx scripts/doctor.ts",
    "demo:record": "node --import tsx scripts/showcase.ts",
    "assets:render": "node scripts/render-assets.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.0",
    "luxon": "^3.7.2",
    "pg": "^8.16.3",
    "pino": "^9.9.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@eslint/js": "^9.35.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "eslint": "^9.35.0",
    "gifenc": "1.0.3",
    "sharp": "0.35.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  },
  "description": "AI LinkedIn content with Telegram approval, scoped revisions, durable scheduling, and optional analytics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/atasardacagan/postrail.git"
  },
  "bugs": {
    "url": "https://github.com/atasardacagan/postrail/issues"
  },
  "homepage": "https://github.com/atasardacagan/postrail#readme"
}
